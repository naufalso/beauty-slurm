#!/usr/bin/env bash

# beauty-slurm: sjobs (Smart Job Monitor)
# Beautified replacement for squeue with clean columns, GPU highlights, and pending diagnostic details.

# Source library files
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BASE_DIR="$(dirname "$BIN_DIR")"

if [ -f "$BASE_DIR/lib/core.sh" ]; then
    source "$BASE_DIR/lib/core.sh"
    source "$BASE_DIR/lib/slurm_api.sh"
else
    echo "Error: Core libraries not found." >&2
    exit 1
fi

# Print Help
show_help() {
    cat <<EOF
${CLR_PURPLE}${STYLE_BOLD}Beauty SLURM: sjobs${STYLE_RESET} (Smart Job Monitor)

Beautified replacement for standard ${CLR_CYAN}squeue${STYLE_RESET} command.

${STYLE_BOLD}Usage:${STYLE_RESET} sjobs [options] [squeue-options]

${STYLE_BOLD}Options:${STYLE_RESET}
  --me             Filter jobs by your username (${CLR_GREEN}$USER${STYLE_RESET})
  --color=VAL      Force color modes: auto (default), always, never
  --mock           Force local mocking layer (for offline testing)
  -h, --help       Show this help message

All other flags and arguments are directly forwarded to ${CLR_CYAN}squeue${STYLE_RESET}.

${STYLE_BOLD}Examples:${STYLE_RESET}
  sjobs --me
  sjobs -p gpu --state=RUNNING
  sjobs --color=never | grep my_run
EOF
    exit 0
}

# Check for help
for arg in "$@"; do
    if [[ "$arg" == "-h" || "$arg" == "--help" ]]; then
        show_help
    fi
done

# Parse global flags
parse_global_flags "$@"

# Check for --me and -w/--wide flags
SQUEUE_ARGS=()
WIDE_MODE=0
while [[ $# -gt 0 ]]; do
    case "$1" in
        --me)
            SQUEUE_ARGS+=("-u" "$USER")
            shift
            ;;
        -w|--wide)
            WIDE_MODE=1
            shift
            ;;
        --color=*|--mock)
            # Already handled by parse_global_flags
            shift
            ;;
        *)
            SQUEUE_ARGS+=("$1")
            shift
            ;;
    esac
done

# Initialize SLURM environment
bootstrap_slurm_environment

# Run squeue using piped formatting
# Format: JobID | Partition | Name | User | State | TimeUsed | TimeLimit | NodeCount | Nodelist(or reason) | CPUs | Memory | GRES | SubmitTime | StartTime
if [ "$WIDE_MODE" -eq 1 ]; then
    raw_output=$(squeue "${SQUEUE_ARGS[@]}" -h -o "%i|%P|%j|%u|%T|%M|%l|%D|%R|%C|%m|%b|%V|%S" 2>&1)
else
    raw_output=$(squeue "${SQUEUE_ARGS[@]}" -h -o "%i|%P|%j|%u|%T|%M|%l|%D|%R|%C|%m|%b" 2>&1)
fi
exit_code=$?

# If squeue failed, print its error and exit
if [ "$exit_code" -ne 0 ]; then
    echo -e "$raw_output" >&2
    exit "$exit_code"
fi

# If no jobs, print friendly message
if [ -z "$raw_output" ]; then
    success "No active or pending jobs found."
    exit 0
fi

# Formats standard SLURM timestamp (e.g. 2026-05-20T12:00:00) into clean MM-DD HH:MM
format_time_compact() {
    local raw_t="$1"
    if [[ -z "$raw_t" || "$raw_t" == "N/A" || "$raw_t" == "Unknown" ]]; then
        echo "-"
        return
    fi
    # Match and group elements
    if [[ "$raw_t" =~ ([0-9]{4})-([0-9]{2})-([0-9]{2})T([0-9]{2}):([0-9]{2}) ]]; then
        echo "${BASH_REMATCH[2]}-${BASH_REMATCH[3]} ${BASH_REMATCH[4]}:${BASH_REMATCH[5]}"
    else
        echo "$raw_t"
    fi
}

# Define widths for aligned columns
W_ID=9
W_PART=11
W_NAME=16
W_USER=12
W_STATE=12
W_TIME=17
W_RES=16
W_SUBMIT=13
W_START=13

# Print Header
hdr_id=$(pad_right "JOB ID" $W_ID)
hdr_part=$(pad_right "PARTITION" $W_PART)
hdr_name=$(pad_right "JOB NAME" $W_NAME)
hdr_user=$(pad_right "USER" $W_USER)
hdr_state=$(pad_right "STATE" $W_STATE)
hdr_time=$(pad_right "TIME / LIMIT" $W_TIME)
hdr_res=$(pad_right "RESOURCES" $W_RES)
hdr_submit=$(pad_right "SUBMIT TIME" $W_SUBMIT)
hdr_start=$(pad_right "START TIME" $W_START)
hdr_node="NODELIST / PENDING REASON"

# Colorize header if colors are active
if [ -n "$STYLE_BOLD" ]; then
    if [ "$WIDE_MODE" -eq 1 ]; then
        echo -e "${STYLE_BOLD}${COLOR_PRIMARY}${hdr_id} ${hdr_part} ${hdr_name} ${hdr_user} ${hdr_state} ${hdr_time} ${hdr_res} ${hdr_submit} ${hdr_start} ${hdr_node}${STYLE_RESET}"
        echo -e "${CLR_GREY}$(pad_right "" 142 "-")${STYLE_RESET}"
    else
        echo -e "${STYLE_BOLD}${COLOR_PRIMARY}${hdr_id} ${hdr_part} ${hdr_name} ${hdr_user} ${hdr_state} ${hdr_time} ${hdr_res} ${hdr_node}${STYLE_RESET}"
        echo -e "${CLR_GREY}$(pad_right "" 115 "-")${STYLE_RESET}"
    fi
else
    if [ "$WIDE_MODE" -eq 1 ]; then
        echo -e "${hdr_id} ${hdr_part} ${hdr_name} ${hdr_user} ${hdr_state} ${hdr_time} ${hdr_res} ${hdr_submit} ${hdr_start} ${hdr_node}"
        echo -e "$(pad_right "" 142 "-")"
    else
        echo -e "${hdr_id} ${hdr_part} ${hdr_name} ${hdr_user} ${hdr_state} ${hdr_time} ${hdr_res} ${hdr_node}"
        echo -e "$(pad_right "" 115 "-")"
    fi
fi

# Loop through squeue rows
while IFS='|' read -r j_id j_part j_name j_user j_state j_time j_limit j_ncount j_nlist j_cpus j_mem j_gres j_submit j_start; do
    # Skip empty lines
    if [ -z "$j_id" ]; then continue; fi

    # 1. Format Job ID
    f_id=$(pad_right "$j_id" $W_ID)

    # 2. Format Partition
    f_part=$(pad_right "$j_part" $W_PART)

    # 3. Format Name (truncate if too long to maintain alignment)
    if [ "${#j_name}" -gt $((W_NAME - 1)) ]; then
        f_name="${j_name:0:$((W_NAME - 4))}..."
    else
        f_name="$j_name"
    fi
    f_name=$(pad_right "$f_name" $W_NAME)

    # 4. Format User
    # Highlight current user in bold green
    if [ "$j_user" == "$USER" ] && [ -n "$CLR_GREEN" ]; then
        f_user=$(pad_right "${STYLE_BOLD}${CLR_GREEN}${j_user}${STYLE_RESET}" $W_USER)
    else
        f_user=$(pad_right "$j_user" $W_USER)
    fi

    # 5. Format State (colorized with icons)
    state_color="$CLR_GREY"
    state_icon="$ICON_PENDING"
    case "$j_state" in
        RUNNING)
            state_color="$COLOR_SUCCESS"
            state_icon="$ICON_RUNNING"
            ;;
        PENDING)
            state_color="$COLOR_WARNING"
            state_icon="$ICON_PENDING"
            ;;
        COMPLETING)
            state_color="$COLOR_INFO"
            state_icon="🔄"
            ;;
        CANCELLED|FAILED|NODE_FAIL|TIMEOUT)
            state_color="$COLOR_DANGER"
            state_icon="$ICON_CANCEL"
            ;;
    esac
    
    if [ -n "$STYLE_BOLD" ]; then
        f_state=$(pad_right "${state_color}${state_icon} ${j_state}${STYLE_RESET}" $W_STATE)
    else
        f_state=$(pad_right "$j_state" $W_STATE)
    fi

    # 6. Format Time / Limit
    # Render time cleanly as "12h34m / 24h00m" if in HH:MM:SS or DD-HH:MM:SS format
    t_clean=$(echo "$j_time" | sed -E 's/:[0-9]{2}$//') # strip seconds for brevity
    l_clean=$(echo "$j_limit" | sed -E 's/:[0-9]{2}$//')
    f_time=$(pad_right "$t_clean / $l_clean" $W_TIME)

    # 7. Format Resources (CPUs, Memory, GPUs)
    # GPU focus: parse GRES to extract GPUs
    gpu_prettified=$(parse_gres "$j_gres")
    f_res=""
    if [ -n "$gpu_prettified" ]; then
        if [ -n "$CLR_ORANGE" ]; then
            f_res="${STYLE_BOLD}${CLR_ORANGE}${ICON_GPU} ${gpu_prettified}${STYLE_RESET}"
        else
            f_res="${ICON_GPU} ${gpu_prettified}"
        fi
    else
        mem_gb=$(parse_memory_to_gb "$j_mem")
        if [ "$mem_gb" -gt 0 ]; then
            f_res="${j_cpus}c/${mem_gb}G"
        else
            f_res="${j_cpus}c"
        fi
    fi
    f_res=$(pad_right "$f_res" $W_RES)

    # 8. Format Submit and Start timestamps (wide mode only)
    f_submit=""
    f_start=""
    if [ "$WIDE_MODE" -eq 1 ]; then
        c_sub=$(format_time_compact "$j_submit")
        c_str=$(format_time_compact "$j_start")
        
        f_submit=$(pad_right "$c_sub" $W_SUBMIT)
        f_start=$(pad_right "$c_str" $W_START)
    fi

    # 9. Format Nodelist / Pending Reason
    f_node=""
    if [ "$j_state" == "PENDING" ]; then
        # Translate to friendly warning reason
        f_node=$(translate_pending_reason "$j_nlist")
    else
        # Running or completing, show actual node list
        if [ -n "$CLR_CYAN" ]; then
            f_node="${CLR_CYAN}${j_nlist}${STYLE_RESET}"
        else
            f_node="$j_nlist"
        fi
    fi

    # Output formatted row
    if [ "$WIDE_MODE" -eq 1 ]; then
        echo -e "${f_id} ${f_part} ${f_name} ${f_user} ${f_state} ${f_time} ${f_res} ${f_submit} ${f_start} ${f_node}"
    else
        echo -e "${f_id} ${f_part} ${f_name} ${f_user} ${f_state} ${f_time} ${f_res} ${f_node}"
    fi

done <<< "$raw_output"
